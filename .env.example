# Jarvis secrets — fill in what you use, no coding needed.

# 1) Wake word (say "Jarvis" to activate voice mode). Free key:
#    https://console.picovoice.ai/  -> Access Key -> copy it after the =
PICOVOICE_ACCESS_KEY=

# 2) GitHub — after 'gh auth login' (see Start-Jarvis-Chat.bat instructions)
#    you can leave everything below empty.
GITHUB_TOKEN=
VERCEL_TOKEN=
SUPABASE_ACCESS_TOKEN=
