# Jarvis Relay — copy to .env on the VPS (same folder as relay.mjs)
# Values are the SAME keys your PC Jarvis uses (in Downloads\AI\.env).

# Your existing Groq key (the cloud brain)
JARVIS_CLOUD_API_KEY=

# A SECOND Telegram bot token from @BotFather (e.g. "JarvisCloud" bot) —
# do NOT reuse the home bot token; two pollers on one token steal updates.
TELEGRAM_BOT_TOKEN=

# Optional: pin the model (default openai/gpt-oss-20b)
JARVIS_CLOUD_MODEL=openai/gpt-oss-20b
